pkgname=yt-chatterino
pkgver=2.0.1
pkgrel=1
pkgdesc='Native C++ YouTube and Twitch chat client inspired by Chatterino'
arch=('x86_64')
url='https://github.com/GuiCraftBR-eu/YT-Chatterino'
license=('LicenseRef-proprietary')
depends=('qt6-base' 'qt6-svg' 'qt6-imageformats' 'libsecret' 'ttf-dejavu')
makedepends=('cmake' 'ninja' 'gcc')
checkdepends=('xorg-server-xvfb' 'xorg-xauth')
optdepends=('polkit: in-app package updates'
            'gnome-keyring: Secret Service for encrypted saved sign-ins'
            'kwallet: a Secret Service compatible desktop keyring'
            'pipewire-audio: notification sounds using pw-play'
            'libpulse: notification sounds using paplay'
            'noto-fonts-emoji: color emoji')
source=()
sha256sums=()

build() {
  cmake -S "$startdir/../.." -B "$srcdir/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=ON
  cmake --build "$srcdir/build" --parallel 2
}

check() {
  QT_QPA_PLATFORM=offscreen ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
