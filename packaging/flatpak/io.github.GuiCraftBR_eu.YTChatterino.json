{
  "id": "io.github.GuiCraftBR_eu.YTChatterino",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "yt-chatterino",
  "finish-args": ["--share=ipc", "--share=network", "--socket=wayland", "--socket=fallback-x11",
    "--socket=pulseaudio", "--talk-name=org.freedesktop.secrets"],
  "modules": [
    "libsecret.json",
    {
      "name": "yt-chatterino",
      "buildsystem": "cmake-ninja",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release", "-DBUILD_TESTING=ON"],
      "sources": [{"type": "dir", "path": "../..", "skip": [".git", ".flatpak-builder", "build", "release-assets", "google-oauth-client.json"]}]
    }
  ]
}
