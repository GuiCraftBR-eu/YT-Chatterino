#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/ytchatterino.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "YT-Chatterino @PROJECT_VERSION@v\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductName", "YT-Chatterino @PROJECT_VERSION@v\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "OriginalFilename", "YT-Chatterino.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
