{
  "manifest_version": 3,
  "name": "YT-Chatterino",
  "version": "2.5.1",
  "description": "Find open livestreams and synchronize VOD chat with YT-Chatterino on this computer.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT-Chatterino",
    "default_icon": {
      "512": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.twitch.tv/*",
        "https://m.twitch.tv/*",
        "https://kick.com/*",
        "https://www.kick.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vod-sync@yt-chatterino.local",
      "update_url": "https://raw.githubusercontent.com/GuiCraftBR-eu/YT-Chatterino/main/browser-extension/updates.json",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteActivity"
        ]
      }
    }
  },
  "icons": {
    "512": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*"
  }
}
